PORT=8080
DATA_DIR=/app/data

# PostgreSQL. В Docker compose подставляется сам.
# Локальный API без compose: сначала поднимите postgres и укажите localhost.
DATABASE_URL=postgres://vtbih:vtbih@postgres:5432/vtbih
POSTGRES_PASSWORD=vtbih

# Внутри compose API ходит в сервис docling по имени контейнера.
# Если поднимаете API без Docker — замените на http://localhost:5001
DOCLING_URL=http://docling:5001
DOCLING_TIMEOUT_MS=900000
DOCLING_TABLE_MODE=accurate

# Устройство разбора документов: cpu (по умолчанию) или gpu.
# Наличие видеокарты не гарантирует ускорения — проверьте замером:
# scripts\bench-docling.ps1 -File <документ> -Apply
VTBIH_DEVICE=cpu

# Офисная сетевая Qwen (LAN). Стартовый вариант в Настройках — «Локальная сеть».
# Облачные ключи OpenAI / Claude / Gemini и т.д. задаются в UI и пишутся в PostgreSQL, не сюда.
SUMMARY_API_BASE_URL=http://192.168.215.74:9080/v1
SUMMARY_MODEL=Qwen/Qwen3.5-35B-A3B-FP8
SUMMARY_API_KEY=
SUMMARY_ENABLE_THINKING=false

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_MS=300000
LLM_MAX_DOC_CHARS=80000

# Необязательно: Brave Search API. Без ключа мониторинг СМИ идёт через RSS указанных сайтов и публичный веб-поиск.
BRAVE_SEARCH_API_KEY=

# Почта CRM подключается в UI (SMTP). Пароль хранится в PostgreSQL, не здесь.
